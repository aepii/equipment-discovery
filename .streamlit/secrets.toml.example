# Paste this (filled in) into the app's Secrets on Streamlit Community Cloud
# (App > Settings > Secrets). Never commit a real secrets.toml.
LLM_PROVIDER = "gemini"
GEMINI_API_KEY = "..."
GEMINI_MODEL = "gemini-3.8-flash"

GEMINI_FALLBACK_MODEL = ""   # optional, e.g. a lighter tier

# Cost tracking and limits (USD per million tokens from the pricing page; empty = no limit)
PRICE_IN_PER_M = ""
PRICE_OUT_PER_M = ""
MAX_CALLS_PER_SESSION = "30"
DAILY_BUDGET_USD = "2"

# Saved answers (data/demo_answers.json): shown if the live model fails; DEMO_OFFLINE = "1" never calls it
DEMO_BACKUP = "1"
DEMO_OFFLINE = "0"

# Shared password for the public link; leave out to disable the gate.
APP_PASSWORD = "..."

# Logging answers and feedback to a Google Sheet (see README, "Logging and feedback").
GOOGLE_SHEET_ID = "the long ID from the sheet's URL"
# Paste the whole service-account key file between the triple quotes, unchanged.
GOOGLE_SERVICE_ACCOUNT_JSON = '''
{ "type": "service_account", "...": "..." }
'''
