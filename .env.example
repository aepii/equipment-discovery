# Copy to .env and fill in. Never commit .env.
# gemini | openai | ollama | mock
# (ollama = local model, works offline; mock = canned answers, no API key needed)
LLM_PROVIDER=mock

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local model via Ollama (no API key, no internet once the model is pulled)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=8192

# --- Speed and resilience (all optional) ---
# Tried once when the main model keeps failing with rate limits / server errors (e.g. a lighter tier)
GEMINI_FALLBACK_MODEL=
OPENAI_FALLBACK_MODEL=
# Per call: timeout, retries of temporary errors, first wait between retries (doubles each time)
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_S=2
# Stream the naive answer as it is written (1/0)
STREAM_NAIVE=1

# --- Cost tracking and limits (optional) ---
# USD per million tokens, from the provider's pricing page; leave empty and cost shows as unknown
PRICE_IN_PER_M=
PRICE_OUT_PER_M=
# Only if the fallback model is priced differently
FALLBACK_PRICE_IN_PER_M=
FALLBACK_PRICE_OUT_PER_M=
# Empty = no limit. The daily budget counts all users of one running app and resets on restart.
MAX_CALLS_PER_SESSION=
DAILY_BUDGET_USD=

# --- Saved answers for the live demo (data/demo_answers.json, made with run_eval.py --record-demo) ---
# Show the saved answer when the live model fails (default 1)
DEMO_BACKUP=1
# Never call the model; answer only from saved answers (no internet at the venue)
DEMO_OFFLINE=0

# --- Mock model testing aids ---
# MOCK_DELAY_S=3     each mock answer takes 3 s
# MOCK_FAIL=429:2    the next 2 calls fail with error 429
# MOCK_FALLBACK_MODEL=mock-lite

# Optional shared password gate for the app (leave empty locally to disable)
APP_PASSWORD=

# Optional: log answers and feedback to a Google Sheet (otherwise results/log.jsonl)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
