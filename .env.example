# Copy to .env and fill in. Never commit .env.
# gemini | openai | ollama | mock
# (ollama = local model, works offline; mock = canned answers, no API key needed)
LLM_PROVIDER=mock

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local model via Ollama (no API key, no internet once the model is pulled)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=8192

# Optional shared password gate for the app (leave empty locally to disable)
APP_PASSWORD=
